{
  "problemMatcher": [
    {
      "owner": "msvc-error",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+>)?\\s*([A-Za-z]:[^\\(]+|[^\\s\\(][^\\(]*)\\((\\d+)(?:,(\\d+))?\\)\\s*:\\s+(?:fatal\\s+)?(error)\\s+([A-Z]+\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      ]
    },
    {
      "owner": "msvc-link-error",
      "pattern": [
        {
          "regexp": "^(?:\\s*\\d+>)?\\s*([^\\s:]+\\.(?:obj|lib|exe))\\s*:\\s+(?:fatal\\s+)?(error)\\s+(LNK\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "severity": 2,
          "code": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "cmake-error",
      "pattern": [
        {
          "regexp": "^CMake (Error) at ([^:]+):(\\d+)",
          "severity": 1,
          "file": 2,
          "line": 3
        },
        {
          "regexp": "^\\s+(.+)$",
          "message": 1
        }
      ]
    }
  ]
}
